{
  "name": "ai-sales-team",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "bash scripts/verify.sh",
    "venv": "bash scripts/setup-venv.sh",
    "demo": "npm run demo:hybrid",
    "demo:mock": "MODE=mock GATE=auto tsx src/demo/run.ts",
    "demo:hybrid": "bash -c 'set -a && source .env.local && set +a && MODE=hybrid GATE=auto tsx src/demo/run.ts'",
    "demo:hybrid-cli": "bash -c 'set -a && source .env.local && set +a && MODE=hybrid GATE=cli tsx src/demo/run.ts'",
    "demo:live": "bash -c 'set -a && source .env.local && set +a && MODE=live GATE=cli tsx src/demo/run.ts'",
    "smoke": "tsx src/demo/mca-smoke.ts",
    "smoke:mca": "bash -c 'set -a && source .env.local && set +a && tsx src/demo/mca-live.ts'",
    "smoke:gate": "tsx src/demo/http-gate-smoke.ts",
    "smoke:search": "tsx src/demo/search-smoke.ts",
    "db:reset": "rm -f data/app.db data/app.db-journal data/app.db-wal data/app.db-shm",
    "worker": "bash -c 'set -a && source .env.local && set +a && tsx scripts/worker.ts'"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.0",
    "@anthropic-ai/sdk": "^0.40.0",
    "@astrojs/node": "^9.0.0",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.0.0",
    "axios": "^1.15.0",
    "better-sqlite3": "^11.0.0",
    "p-limit": "^7.3.0",
    "resend": "^4.0.0",
    "tailwindcss": "^3.4.19",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
