---
import Base from '../layouts/Base.astro'
import { PERSONAS } from '../../personas/registry'
const list = Object.values(PERSONAS)
const tierFor = (m: string) => m.includes('opus') ? 'Opus · top' : m.includes('sonnet') ? 'Sonnet · smart' : 'Haiku · fast'
---
<Base title="the team">
  <div class="dense">
    <div class="border-b border-border pb-4">
      <div class="uppercase-label">seven specialists</div>
      <h1 class="serif mt-1">The Team</h1>
      <p class="body-serif text-muted-fg mt-2 max-w-2xl">
        Each persona owns a specific role in the pipeline: makers produce, checkers critique, arbiters decide.
        Model tier matches role: Opus for arbitration, Sonnet for generation, Haiku for ruthless critique.
      </p>
    </div>

    <div class="grid gap-3" style="grid-template-columns: repeat(auto-fit, minmax(360px, 1fr))">
      {list.map((p) => (
        <div class="card">
          <div class="flex items-baseline justify-between">
            <div>
              <div class="serif text-2xl font-semibold">{p.name}</div>
              <div class="mono text-xs uppercase tracking-wider text-muted-fg mt-0.5">{p.designation}</div>
            </div>
            <span class="chip">{tierFor(p.model)}</span>
          </div>
          <div class="body-serif text-xs italic text-muted-fg mt-3">voice · {p.voice}</div>
          <details class="mt-3">
            <summary class="cursor-pointer mono text-xs uppercase tracking-wider text-muted-fg">system prompt</summary>
            <pre class="body-serif text-xs whitespace-pre-wrap mt-2 bg-muted p-3">{p.system}</pre>
          </details>
          {p.tools.length > 0 && (
            <div class="mt-3">
              <div class="uppercase-label">tools</div>
              <div class="flex flex-wrap gap-1 mt-1">
                {p.tools.map(t => <span class="chip">{t}</span>)}
              </div>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</Base>
