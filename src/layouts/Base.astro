---
import '../styles/global.css'
const { title = 'AI Sales Team' } = Astro.props
const authed = (Astro.locals as any).authed === true
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script src="https://unpkg.com/htmx.org@2.0.4" integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+" crossorigin="anonymous"></script>
  </head>
  <body class="min-h-screen">
    <header class="border-b-2 border-border">
      <div class="px-6 py-3 flex items-center justify-between">
        <a href="/" class="flex items-baseline gap-3">
          <span class="serif font-bold text-lg tracking-tight">AI Sales Team</span>
          <span class="mono text-xs text-muted-fg uppercase tracking-wider">outbound · v0.1</span>
        </a>
        <nav class="flex gap-5 mono text-xs uppercase tracking-wider">
          {authed ? (
            <>
              <a href="/">campaigns</a>
              <a href="/personas">the team</a>
              <a href="/new" class="btn btn-accent">new campaign</a>
            </>
          ) : (
            <span class="text-muted-fg">private trial</span>
          )}
        </nav>
      </div>
    </header>
    <main class="px-6 py-6 max-w-[1600px] mx-auto">
      <slot />
    </main>
    <footer class="border-t border-border px-6 py-3 mono text-[11px] text-muted-fg flex justify-between uppercase tracking-wider">
      <span>brutalist · editorial · oklch · radius 0</span>
      <span>hackathon · revenue · opencode</span>
    </footer>
  </body>
</html>
